{
  "name": "taxipannel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "bun run --filter '@taxipannel/api' dev",
    "dev:web": "bun run --filter '@taxipannel/web' dev",
    "dev": "bun run dev:api & bun run dev:web",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "ci": "biome ci . && bun run typecheck",
    "build": "bun run --filter '@taxipannel/web' build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bun": "^1.3.14",
    "typescript": "^5.7.3"
  }
}

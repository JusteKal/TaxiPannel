# --- Ports -------------------------------------------------------------
WEB_PORT=8080
API_PORT=3000

# --- Uploads -----------------------------------------------------------
MAX_UPLOAD_BYTES=12582912       # 12 MiB per image
MAX_ASSETS_PER_SESSION=40
MAX_IMAGES_PER_PANEL=20
MAX_IMAGE_PIXELS=40000000       # decompression-bomb guard, checked before decode
MAX_SOURCE_FRAMES=120           # animated GIF sources are truncated past this
ASSET_TTL_MS=1800000            # 30 min idle

# --- Encoding ----------------------------------------------------------
FFMPEG_PATH=ffmpeg
GIFSICLE_PATH=gifsicle
TMP_DIR=/tmp/taxipannel
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=8
MAX_FRAMES=3000                 # hard refusal; 600 is the soft warning
MAX_OUTPUT_BYTES=5242880        # 5 MiB. Past this the encoder degrades and retries.
JOB_TIMEOUT_MS=120000
JOB_TTL_MS=600000               # how long a finished GIF stays downloadable
MAX_JOBS=200

# --- Limits ------------------------------------------------------------
RATE_LIMIT_PER_MIN=600
UPLOAD_LIMIT_PER_10MIN=200
JOB_LIMIT_PER_10MIN=30
TRUST_PROXY=false               # true ONLY behind a proxy that rewrites XFF
